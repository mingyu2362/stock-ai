# 이 파일을 복사해 .env 로 만들고 값을 채운다. (.env 는 절대 GitHub에 올리지 않음)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=
# 한투 서버: paper(모의투자, 기본) / real(실전). 이번 학기는 paper
KIS_ENV=paper
# 실전 계좌 키 (모의투자 키와 다름). KIS_REAL_ORDER=yes 가 있어야 실전 주문이 나감
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT=
KIS_REAL_ORDER=
DART_API_KEY=
KRX_ID=
KRX_PW=
